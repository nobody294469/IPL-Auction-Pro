# GEMINI_API_KEY: Required for server-side Gemini AI features (Auction summaries, draft insights, tactical advice).
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: Base URL for deployment environments. Defaults to http://localhost:3000.
APP_URL="http://localhost:3000"

# FIREBASE_PROJECT_ID: (Optional) Override Firebase Project ID for Socket.io token verification.
# Defaults to projectId found in firebase-applet-config.json ("ai-studio-applet-webapp-88e2d").
FIREBASE_PROJECT_ID="ai-studio-applet-webapp-88e2d"
